# Repository-wide rules only. Each assignment folder keeps its own .gitignore
# (e.g. src/assignment_02/ATML-PA2-LLM-PostTraining/.gitignore) for project-specific paths.
# Do not add folder-name rules such as tests/, scripts/ or docs/ here: they match at
# every depth and would hide those folders in other assignments.

# General Python files
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environment
env/
venv/
.venv/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/

# Caches
.cache/
.pytest_cache/

# Logs and temporary files
*.log
*.tmp
# PA2 run logs are small saved results that support the report
!src/assignment_02/ATML-PA2-LLM-PostTraining/results/**/*.log

# AI/ML specific
# Datasets (if too large for Git - use DVC otherwise)
data/raw/
data/processed/

# Models and checkpoints
models/*.h5
models/*.pkl
models/*.onnx
models/*.pt
# Ignore checkpoint contents at any depth, but keep a README explaining how to obtain them
**/checkpoints/*
!**/checkpoints/README.md
runs/
logs/

# Notebook specific
.ipynb_checkpoints
